{
  "name": "boardgame-turn-timer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Realtids-turordningsklocka (schackklocka) för en Settlers of Catan-turnering.",
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"yarn dev:server\" \"yarn dev:web\"",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "tsx server/src/index.ts",
    "host": "yarn build && yarn start",
    "tunnel": "cloudflared tunnel --url http://localhost:3000",
    "tournament": "yarn build && concurrently -k -n app,tunnel -c green,yellow \"caffeinate -s yarn start\" \"yarn tunnel\"",
    "typecheck": "tsc -p server/tsconfig.json && tsc -p web/tsconfig.json"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sirv": "^2.0.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^5.4.11"
  },
  "engines": {
    "node": ">=20"
  },
  "volta": {
    "node": "22.13.1",
    "yarn": "1.22.21"
  },
  "packageManager": "yarn@1.22.21"
}
